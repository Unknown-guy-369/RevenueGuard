  "cards": [
    {
      "dot": "emerald",
      "title": "Implemented scope",
      "items": [
        "Failed subscriptions; degradation deferral; receivables and promises.",
        "All application services persist through SQLAlchemy; Alembic manages schema.",
        "Next.js + FastAPI + worker; Compose runs PostgreSQL and Redis."
      ]
    },
    {
      "dot": "amber",
      "title": "Safety and control",
      "items": [
        "PROCEED / DEFER / SKIP / STOP / REQUIRE_HUMAN; review and wakeup recheck policy.",
        "API acceptance is not recovery. UNKNOWN blocks equivalent actions.",
        "Money uses integer minor units; synthetic results are excluded from merchant totals."
      ]
    },
    {
      "dot": "violet",
      "title": "Target architecture still planned",
      "items": [
        "Complete portfolio governor and cross-workflow contact coordination.",
        "SHA-256 audit ledger, full telemetry, calibrated ML and held-out evaluation.",
        "Real contact adapters, extension playbooks and production SQS mapping."
      ]
    }
