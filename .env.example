# Copy this file to .env for local development. Values below are local-only.
REVENUEGUARD_ENVIRONMENT=development
REVENUEGUARD_APP_VERSION=0.1.0
REVENUEGUARD_API_HOST=0.0.0.0
REVENUEGUARD_API_PORT=8000

REVENUEGUARD_DATABASE_URL=postgresql+asyncpg://revenueguard:revenueguard@localhost:5432/revenueguard
REVENUEGUARD_ALEMBIC_DATABASE_URL=postgresql+asyncpg://revenueguard:revenueguard@localhost:5432/revenueguard
REVENUEGUARD_REDIS_URL=redis://localhost:6379/0
REVENUEGUARD_CELERY_BROKER_URL=redis://localhost:6379/1
REVENUEGUARD_CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Sole Test Mode merchant used when Razorpay omits RevenueGuard's internal routing header.
REVENUEGUARD_RAZORPAY_MERCHANT_ID=merchant_demo_001
REVENUEGUARD_RAZORPAY_WEBHOOK_MAX_BODY_BYTES=1048576
REVENUEGUARD_EVENT_DISPATCH_BATCH_SIZE=100
REVENUEGUARD_EVENT_DISPATCH_MAX_ATTEMPTS=5
REVENUEGUARD_EVENT_DISPATCH_STALE_AFTER_SECONDS=60
REVENUEGUARD_ACTION_PROVIDER=SIMULATOR
REVENUEGUARD_ACTION_DISPATCH_BATCH_SIZE=50
REVENUEGUARD_ACTION_DISPATCH_STALE_AFTER_SECONDS=60
REVENUEGUARD_ACTION_RECONCILIATION_BATCH_SIZE=50
REVENUEGUARD_ACTION_UNKNOWN_TTL_SECONDS=3600
# DISABLED keeps the deterministic fallback. OPENAI_COMPATIBLE enables a configured
# cloud or local /v1/chat/completions server. Keep model and base URL blank while disabled.
REVENUEGUARD_AGENT_MODEL_PROVIDER=DISABLED
REVENUEGUARD_AGENT_MODEL_BASE_URL=
REVENUEGUARD_AGENT_MODEL_NAME=
REVENUEGUARD_AGENT_MODEL_RESPONSE_MODE=JSON_SCHEMA
REVENUEGUARD_AGENT_MODEL_TOKEN_LIMIT_FIELD=MAX_COMPLETION_TOKENS
REVENUEGUARD_AGENT_MODEL_TIMEOUT_SECONDS=2
REVENUEGUARD_AGENT_WORKFLOW_TIMEOUT_SECONDS=8
REVENUEGUARD_AGENT_MODEL_MAX_RETRIES=1
REVENUEGUARD_AGENT_MODEL_MAX_OUTPUT_TOKENS=512
REVENUEGUARD_AGENT_GRAPH_MAX_STEPS=8
REVENUEGUARD_RAZORPAY_TIMEOUT_SECONDS=10

# Keep external credentials blank until the relevant implementation phase.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LLM_API_KEY=

# Server-side web configuration. Do not put secrets in NEXT_PUBLIC_* variables.
REVENUEGUARD_API_URL=http://localhost:8000
# Dashboard bearer token is shared only by the API and Next.js server. Generate
# independent high-entropy values for these three secrets in every environment.
REVENUEGUARD_DASHBOARD_API_TOKEN=
REVENUEGUARD_DASHBOARD_MERCHANT_ID=merchant_demo_001
REVENUEGUARD_DASHBOARD_OPERATOR_ACCESS_KEY=
REVENUEGUARD_DASHBOARD_SESSION_SECRET=
NEXT_PUBLIC_REVENUEGUARD_ENVIRONMENT=development
